{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "from typing import Any, Optional, Union\nimport re\n\n# Custom exception for parsing errors.\nclass ParseError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n# Regex for validating numeric string format.\nNUMERIC_REGEX = r'^[+-]?\\d+(\\.\\d+)?$'\n\n# Utility function to normalize numeric strings.\ndef normalize_numeric_string(s: str) -> str:\n    \"\"\"Strips whitespace and replaces comma decimal separators with a dot.\"\"\"\n    s = s.strip()\n    return s.replace(',', '.')\n\n# Utility function to check if a string is numeric.\ndef is_numeric_string(s: str) -> bool:\n    \"\"\"Validates if a string matches the defined numeric pattern.\"\"\"\n    return bool(re.fullmatch(NUMERIC_REGEX, s))\n\n# Data model to encapsulate parsed values.\nclass ValueWrapper:\n    \"\"\"Encapsulates an input value's original representation, its numeric value, and type tag.\"\"\"\n    def __init__(self, original: Any, numeric: float, type_tag: str) -> None:\n        self._original = original\n        self._numeric = numeric\n        self._type_tag = type_tag\n\n    @property\n    def original(self) -> Any:\n        return self._original\n\n    @property\n    def numeric(self) -> float:\n        return self._numeric\n\n    @property\n    def type_tag(self) -> str:\n        return self._type_tag\n\n    def compare_to(self, other: 'ValueWrapper') -> int:\n        \"\"\"Compares numeric values with another wrapper, returning 1 if greater, -1 if less, 0 if equal.\"\"\"\n        if self._numeric > other._numeric:\n            return 1\n        if self._numeric < other._numeric:\n            return -1\n        return 0\n\n    def __repr__(self) -> str:\n        return f\"ValueWrapper(original={self.original!r}, numeric={self.numeric}, type_tag='{self.type_tag}')\"\n\n# Parser class to convert various input types into ValueWrapper.\nclass ValueParser:\n    \"\"\"Converts inputs (int, float, or numeric string) into ValueWrapper objects.\"\"\"\n    def parse(self, value: Any) -> ValueWrapper:\n        \"\"\"Parses the input value into a ValueWrapper, handling different types and string formats.\"\"\"\n        if isinstance(value, bool):\n            raise ParseError(\"bool is not supported\")\n        \n        if isinstance(value, (int, float)):\n            type_tag = 'int' if isinstance(value, int) else 'float'\n            return ValueWrapper(original=value, numeric=float(value), type_tag=type_tag)\n        \n        if isinstance(value, str):\n            try:\n                normalized = normalize_numeric_string(value)\n            except ValueError as e:\n                raise ParseError(str(e))\n            \n            if not is_numeric_string(normalized):\n                raise ParseError(f\"Invalid numeric string format: {value!r}\")\n            \n            try:\n                numeric = float(normalized)\n            except ValueError:\n                raise ParseError(f\"Could not convert string to float after normalization: {value!r}\")\n            \n            return ValueWrapper(original=value, numeric=numeric, type_tag='str')\n        \n        raise ParseError(f\"Unsupported type: {type(value).__name__}\")\n\n# Service class for the core comparison logic.\nclass ComparatorService:\n    \"\"\"Provides the core business logic for comparing two parsed numeric representations.\"\"\"\n    def __init__(self, parser: ValueParser = None) -> None:\n        self._parser = parser or ValueParser()\n\n    def compare(self, a: Any, b: Any) -> Optional[Union[int, float, str]]:\n        \"\"\"Parses and compares two inputs, returning the original larger value or None if equal.\"\"\"\n        lhs = self._parser.parse(a)\n        rhs = self._parser.parse(b)\n        cmp = lhs.compare_to(rhs)\n        if cmp == 1:\n            return lhs.original\n        if cmp == -1:\n            return rhs.original\n        return None\n\n# Controller class as the public API entry point.\nclass CompareController:\n    \"\"\"Public API surface, coordinating service calls and initial argument validation.\"\"\"\n    def __init__(self, service: ComparatorService = None) -> None:\n        self._service = service or ComparatorService()\n\n    def compare_one(self, a: Any, b: Any) -> Optional[Union[int, float, str]]:\n        \"\"\"Compares two values, delegating to the comparison service after basic argument checks.\"\"\"\n        if a is None or b is None:\n            raise TypeError(\"Both values must be provided\")\n        return self._service.compare(a, b)\n\n# Global instance of the controller to be used by the module-level function.\n_global_compare_controller = CompareController()\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    return _global_compare_controller.compare_one(a, b)"}
{"task_id": "HumanEval/139", "solution": "import os\nimport sqlite3\nimport time\nfrom collections import OrderedDict\nfrom dataclasses import dataclass\nfrom typing import Dict, Iterator, Optional, List\n\n\n# 1. Config class (src/special_factorial/config.py)\nDEFAULT_MAX_INPUT = 10000\nDEFAULT_SQLITE_PATH = \"./special_factorial_cache.db\"\nDEFAULT_TTL = 2592000\n\n@dataclass(frozen=True)\nclass Config:\n    max_input: int\n    sqlite_path: str\n    cache_ttl_seconds: int\n    api_key: Optional[str]\n\n    @staticmethod\n    def from_env() -> \"Config\":\n        return Config(\n            max_input=int(os.getenv(\"SF_MAX_INPUT\", DEFAULT_MAX_INPUT)),\n            sqlite_path=os.getenv(\"SF_SQLITE_PATH\", DEFAULT_SQLITE_PATH),\n            cache_ttl_seconds=int(os.getenv(\"SF_CACHE_TTL\", DEFAULT_TTL)),\n            api_key=os.getenv(\"SF_API_KEY\") or None,\n        )\n\n\n# 2. FactorialResponseDTO class (src/special_factorial/models.py)\nclass FactorialResponseDTO:\n    def __init__(self, n: int, result: int, cached: bool, computed_at: Optional[str]) -> None:\n        self.n = n\n        self.result = result\n        self.cached = cached\n        self.computed_at = computed_at\n\n\n# 3. InvalidInputError class (src/special_factorial/exceptions.py)\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n\n\n# 4. CalculationError class (src/special_factorial/exceptions.py)\nclass CalculationError(RuntimeError):\n    def __init__(self, message: str):\n        super().__init__(message)\n\n\n# 5. MathUtils class (src/special_factorial/utils.py)\nclass MathUtils:\n    _factorial_memo: Dict[int, int] = {0: 1, 1: 1}\n\n    @staticmethod\n    def factorial(n: int) -> int:\n        \"\"\"Computes n! using memoization to avoid re-calculation.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be >= 0\")\n        memo = MathUtils._factorial_memo\n        if n in memo:\n            return memo[n]\n        # Find the largest factorial already computed\n        start_from = max(k for k in memo)\n        result = memo[start_from]\n        for i in range(start_from + 1, n + 1):\n            result *= i\n            memo[i] = result\n        return memo[n]\n\n    @staticmethod\n    def brazilian_factorial(n: int) -> int:\n        \"\"\"Computes the Brazilian factorial: n! * (n-1)! * ... * 1!\"\"\"\n        prod = 1\n        for k in range(1, n + 1):\n            prod *= MathUtils.factorial(k)\n        return prod\n\n\n# 6. CacheRepository abstract base class (src/special_factorial/repositories.py)\nclass CacheRepository:\n    def get(self, n: int) -> Optional[int]:\n        raise NotImplementedError\n    def set(self, n: int, value: int) -> None:\n        raise NotImplementedError\n    def delete(self, n: int) -> None:\n        raise NotImplementedError\n\n\n# 7. SQLiteCacheRepository class (src/special_factorial/repositories.py)\nclass SQLiteCacheRepository(CacheRepository):\n    def __init__(self, db_path: str) -> None:\n        self.db_path = db_path\n        self.conn = sqlite3.connect(self.db_path, check_same_thread=False)\n        self.ensure_schema()\n\n    def ensure_schema(self) -> None:\n        \"\"\"Ensures the cache table exists in the SQLite database.\"\"\"\n        cur = self.conn.cursor()\n        cur.execute(\"\"\"CREATE TABLE IF NOT EXISTS cache (n INTEGER PRIMARY KEY, value TEXT NOT NULL, computed_at TIMESTAMP NOT NULL)\"\"\")\n        self.conn.commit()\n\n    def get(self, n: int) -> Optional[int]:\n        cur = self.conn.cursor()\n        cur.execute(\"SELECT value FROM cache WHERE n = ?\", (n,))\n        row = cur.fetchone()\n        return int(row[0]) if row else None\n\n    def set(self, n: int, value: int) -> None:\n        cur = self.conn.cursor()\n        cur.execute(\"INSERT OR REPLACE INTO cache(n, value, computed_at) VALUES (?, ?, ?)\", (n, str(value), time.strftime(\"%Y-%m-%dT%H:%M:%SZ\")))\n        self.conn.commit()\n\n    def delete(self, n: int) -> None:\n        cur = self.conn.cursor()\n        cur.execute(\"DELETE FROM cache WHERE n = ?\", (n,))\n        self.conn.commit()\n\n\n# 8. InMemoryCacheRepository class (src/special_factorial/repositories.py)\nclass InMemoryCacheRepository(CacheRepository):\n    def __init__(self, max_size: int = 1024) -> None:\n        self.cache = OrderedDict()\n        self.max_size = max_size\n\n    def get(self, n: int) -> Optional[int]:\n        val = self.cache.get(n)\n        if val is not None:\n            self.cache.move_to_end(n)\n        return val\n\n    def set(self, n: int, value: int) -> None:\n        self.cache[n] = value\n        self.cache.move_to_end(n)\n        if len(self.cache) > self.max_size:\n            self.cache.popitem(last=False)\n\n    def delete(self, n: int) -> None:\n        self.cache.pop(n, None)\n\n\n# 9. SpecialFactorialService class (src/special_factorial/services.py)\nclass SpecialFactorialService:\n    def __init__(self, cache_repo: CacheRepository, config: Config, in_memory: Optional[InMemoryCacheRepository] = None):\n        self.cache_repo = cache_repo\n        self.config = config\n        self.in_memory = in_memory\n\n    def _validate(self, n: int) -> None:\n        \"\"\"Validates the input n against specified constraints.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer.\")\n        if n <= 0:\n            raise InvalidInputError(\"n must be > 0.\")\n        if n > self.config.max_input:\n            raise InvalidInputError(f\"n must be <= {self.config.max_input}.\")\n\n    def compute(self, n: int) -> FactorialResponseDTO:\n        \"\"\"Computes the special factorial, utilizing caching and memoization.\"\"\"\n        self._validate(n)\n        cached = False\n        computed_at: Optional[str] = None\n\n        # Try in-memory cache first\n        val = self.in_memory.get(n) if self.in_memory else None\n        if val is not None:\n            cached = True\n        else:\n            # Try persistent cache\n            val = self.cache_repo.get(n)\n            if val is not None:\n                # If found in persistent cache, update in-memory cache\n                if self.in_memory:\n                    self.in_memory.set(n, val)\n                cached = True\n            \n        if val is None:\n            # Not in cache, compute it\n            try:\n                res = MathUtils.brazilian_factorial(n)\n                computed_at = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n            except Exception as e:\n                raise CalculationError(f\"Error during factorial computation for n={n}: {e}\")\n            \n            # Store in caches\n            self.cache_repo.set(n, res)\n            if self.in_memory:\n                self.in_memory.set(n, res)\n            val = res\n        \n        return FactorialResponseDTO(n=n, result=val, cached=cached, computed_at=computed_at)\n\n\n# The main function special_factorial as requested (src/special_factorial/__init__.py structure)\n_config = Config.from_env()\n_cache = SQLiteCacheRepository(_config.sqlite_path)\n_inmem = InMemoryCacheRepository()\n_service = SpecialFactorialService(cache_repo=_cache, config=_config, in_memory=_inmem)\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    return _service.compute(n).result"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces sequences of 3 or more spaces with a hyphen, and all other single\n    spaces with an underscore.\n    \"\"\"\n    # First, replace all runs of 3 or more consecutive spaces with a single hyphen.\n    # This ensures that \"   \" becomes \"-\" and leaves \"  \" untouched for the next step.\n    fixed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces (which now also includes each space\n    # from original double spaces) with an underscore.\n    # \"  \" (two spaces) will become \"__\" (two underscores).\n    fixed_text = fixed_text.replace(' ', '_')\n\n    return fixed_text"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    transformed_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            transformed_sum += num * num\n        elif i % 4 == 0:\n            transformed_sum += num * num * num\n        else:\n            transformed_sum += num\n    return transformed_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    \n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    base, ext = file_name.split('.', 1)\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter\n    if not base:\n        return 'No'\n    \n    first_char_base = base[0]\n    if not ('a' <= first_char_base <= 'z' or 'A' <= first_char_base <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext not in allowed_extensions:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"\n        Checks if a given integer n is a prime number.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    maintaining original order for items with similar digit sums.\n    \"\"\"\n    def _get_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    items_with_metadata = []\n    for index, num in enumerate(nums):\n        digit_sum = _get_digit_sum(num)\n        items_with_metadata.append((digit_sum, index, num))\n\n    items_with_metadata.sort(key=lambda x: (x[0], x[1]))\n\n    sorted_nums = [item[2] for item in items_with_metadata]\n\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    import re\n\n    def gcd(a: int, b: int) -> int:\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    def is_positive_int_str(s: str) -> bool:\n        # As per the design snippet, allows '0' for integers.\n        return s.isdigit() and int(s) >= 0\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int) -> None:\n            if denominator == 0:\n                raise ValueError(\"Denominator cannot be zero\")\n            # As per design snippet, only non-negative integers for numerator/denominator are supported.\n            if numerator < 0 or denominator < 0:\n                raise ValueError(\"Only positive integers supported\")\n            self.numerator = numerator\n            self.denominator = denominator\n\n        def reduce(self) -> \"Fraction\":\n            g = gcd(self.numerator, self.denominator)\n            return Fraction(self.numerator // g, self.denominator // g)\n\n        def multiply(self, other: \"Fraction\") -> \"Fraction\":\n            return Fraction(self.numerator * other.numerator, self.denominator * other.denominator)\n\n        def is_whole(self) -> bool:\n            return self.numerator % self.denominator == 0\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.numerator, self.denominator)\n\n    class FractionParser:\n        _pattern = re.compile(r'^\\d+/\\d+$')\n\n        def validate_format(self, s: str) -> bool:\n            return bool(self._pattern.match(s))\n\n        def parse(self, fraction_str: str) -> Fraction:\n            if not self.validate_format(fraction_str):\n                raise ValueError(f\"Invalid fraction format: {fraction_str}\")\n            num_str, den_str = fraction_str.split('/')\n            if not (is_positive_int_str(num_str) and is_positive_int_str(den_str)):\n                # This error message from the design snippet refers to the positive integer requirement.\n                raise ValueError(\"Numerator and denominator must be positive integers\")\n            num = int(num_str)\n            den = int(den_str)\n            if den == 0:\n                raise ValueError(\"Denominator cannot be zero\")\n            return Fraction(num, den)\n\n    class SimplifierService:\n        def __init__(self, parser: \"FractionParser\") -> None:\n            self._parser = parser\n\n        def is_whole_product(self, fx: Fraction, fn: Fraction) -> bool:\n            # Cancel cross factors to avoid potential huge integer products.\n            a, b = fx.numerator, fx.denominator\n            c, d = fn.numerator, fn.denominator\n            g1 = gcd(a, d)\n            a //= g1\n            d //= g1\n            g2 = gcd(c, b)\n            c //= g2\n            b //= g2\n            # The product is a*c / b*d. It's a whole number if b*d is 1.\n            return (b * d) == 1\n\n        def is_whole_from_strings(self, x: str, n: str) -> bool:\n            fx = self._parser.parse(x)\n            fn = self._parser.parse(n)\n            return self.is_whole_product(fx, fn)\n\n    _parser = FractionParser()\n    _service = SimplifierService(_parser)\n\n    return _service.is_whole_from_strings(x, n)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are located between planet1 and planet2, \n    sorted by proximity to the sun. Returns an empty tuple if inputs are invalid \n    or no planets are found between the two.\n    \"\"\"\n    PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    NAME_TO_INDEX = {p.lower(): i for i, p in enumerate(PLANETS)}\n\n    def _normalize_name(name: str) -> str:\n        \"\"\"Normalizes a planet name by stripping whitespace and converting to lowercase.\"\"\"\n        return name.strip().lower()\n\n    idx1 = NAME_TO_INDEX.get(_normalize_name(planet1))\n    idx2 = NAME_TO_INDEX.get(_normalize_name(planet2))\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    # Determine the start and end indices for slicing, ensuring ascending order.\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # If the planets are the same or adjacent, there are no planets strictly between them.\n    if end_idx - start_idx <= 1:\n        return ()\n\n    # Slice the PLANETS list to get the intermediate planets, exclusive of the start and end.\n    intermediate_planets = PLANETS[start_idx + 1:end_idx]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both \n    first and last digits odd.\n    \"\"\"\n\n    # Helper function to convert various types to integer, truncating floats.\n    def _to_int(value):\n        try:\n            if isinstance(value, float):\n                return int(value)\n            return int(value)\n        except (ValueError, TypeError):\n            # If conversion fails, return None to indicate an invalid number that should be skipped.\n            return None\n\n    # Helper function to extract the first and last digits of an integer.\n    def _first_last_digits(n):\n        # Convert the absolute value of the number to a string to easily access digits.\n        s = str(abs(n))\n        first_digit = int(s[0])\n        last_digit = int(s[-1])\n        return first_digit, last_digit\n\n    # Set of odd digits for efficient checking.\n    _ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    count = 0\n    for num in nums:\n        n_int = _to_int(num)\n        \n        # Skip if the value could not be converted to an integer.\n        if n_int is None:\n            continue\n        \n        # Check if the number is greater than 10.\n        if n_int > 10:\n            first, last = _first_last_digits(n_int)\n            \n            # Check if both the first and last digits are odd.\n            if first in _ODD_DIGITS and last in _ODD_DIGITS:\n                count += 1\n                \n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the sequence a where i < j < k\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    def nC3(val):\n        \"\"\"Calculates 'val choose 3', returning 0 if val is less than 3.\"\"\"\n        if val < 3:\n            return 0\n        return (val * (val - 1) * (val - 2)) // 6\n\n    # a[i] = i*i - i + 1. We observe a[i] % 3 == 0 iff i % 3 == 2.\n    # Otherwise, a[i] % 3 == 1.\n    \n    # Count of elements a[x] such that a[x] % 3 == 0.\n    # This corresponds to counting i in [1, n] such that i % 3 == 2.\n    count_mod0 = n // 3 + (1 if n % 3 >= 2 else 0)\n\n    # Count of elements a[x] such that a[x] % 3 == 1.\n    # This is the total number of elements minus those that are 0 mod 3.\n    count_mod1 = n - count_mod0\n\n    # A sum (a[i] + a[j] + a[k]) is a multiple of 3 if all three elements are 0 mod 3,\n    # or all three elements are 1 mod 3 (since 0+0+0=0 and 1+1+1=3 which is 0 mod 3).\n    \n    # Number of ways to choose 3 elements from those that are 0 mod 3.\n    triples_from_mod0 = nC3(count_mod0)\n\n    # Number of ways to choose 3 elements from those that are 1 mod 3.\n    triples_from_mod1 = nC3(count_mod1)\n\n    return triples_from_mod0 + triples_from_mod1"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def _is_prime(num):\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num % 2 == 0:\n            return num == 2\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    return x if _is_prime(n) else y"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, removes strings with odd lengths,\n    and returns the remaining strings sorted by length (ascending)\n    with alphabetical (case-insensitive) tie-breakers.\n    \"\"\"\n    \n    # Filter out strings that have odd lengths\n    filtered_list = [word for word in lst if len(word) % 2 == 0]\n    \n    # Sort the remaining list\n    # Primary sort key: length of the word (ascending)\n    # Secondary sort key: alphabetical order (case-insensitive)\n    sorted_list = sorted(filtered_list, key=lambda word: (len(word), word.lower()))\n    \n    return sorted_list"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Only process numbers that are integers, non-negative, and odd.\n        if isinstance(num, int) and num >= 0 and num % 2 == 1:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of each extension and returns the strongest one\n    in the format 'ClassName.StrongestExtensionName'.\n    Strength is determined by (uppercase letters - lowercase letters).\n    Ties are broken by choosing the extension that appears first in the list.\n    \"\"\"\n\n    # This list will store tuples of (strength, original_index, extension_name)\n    # We use original_index to ensure stable tie-breaking:\n    # a smaller index means it appeared earlier in the input list.\n    extension_strengths = []\n\n    for i, ext_name in enumerate(extensions):\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':  # char.isupper() for robustness with unicode\n                cap_count += 1\n            elif 'a' <= char <= 'z':  # char.islower() for robustness with unicode\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        extension_strengths.append((current_strength, i, ext_name))\n\n    # Find the strongest extension.\n    # The key function prioritizes:\n    # 1. Highest strength (current_strength)\n    # 2. Smallest original_index (i) to break ties (by negating, max() picks the smallest positive index)\n    strongest_entry = max(extension_strengths, key=lambda x: (x[0], -x[1]))\n\n    strongest_ext_name = strongest_entry[2]\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    return [abs(g_score - g_guess) for g_score, g_guess in zip(game, guess)]"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_digits_count = 0\n    odd_digits_count = 0\n    \n    # Normalize the number by taking its absolute value and converting to a string.\n    # The design specifies to ignore the sign and treat digits of abs(num).\n    num_str = str(abs(num))\n    \n    for digit_char in num_str:\n        # Convert char digit to int.\n        # The design uses `(ord(ch) - ord('0'))` to convert character to integer.\n        digit = ord(digit_char) - ord('0')\n        if digit % 2 == 0:\n            even_digits_count += 1\n        else:\n            odd_digits_count += 1\n            \n    return (even_digits_count, odd_digits_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    roman_parts = []\n    n = number\n    for value, symbol in roman_map:\n        while n >= value:\n            roman_parts.append(symbol)\n            n -= value\n    return \"\".join(roman_parts).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Side lengths must be positive\n    if s1 <= 0:\n        return False\n\n    # Check triangle inequality: sum of any two sides must be greater than the third\n    if s1 + s2 <= s3:\n        return False\n\n    # Check Pythagorean theorem with a small tolerance for floating point errors\n    epsilon = 1e-9\n    sum_of_squares = s1*s1 + s2*s2\n    hypotenuse_square = s3*s3\n\n    # Check approximate equality: abs(x - y) <= epsilon * max(1.0, abs(x), abs(y))\n    return abs(sum_of_squares - hypotenuse_square) <= epsilon * max(1.0, abs(sum_of_squares), abs(hypotenuse_square))"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a meal.\n    This function implements the core logic for the 'eat' operation.\n    \"\"\"\n    eaten_during_meal = min(need, remaining)\n    total_eaten_after_meal = number + eaten_during_meal\n    remaining_after_meal = remaining - eaten_during_meal\n    return [total_eaten_after_meal, remaining_after_meal]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        # Per design, input list is non-empty. If it could be empty and\n        # no error handling is allowed, returning \"\" is a common fallback\n        # or would depend on desired behavior.\n        # Given examples and design context, we assume words is non-empty.\n        return \"\"\n\n    best_word = words[0]\n    best_count = len(set(words[0]))\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_count = len(set(current_word))\n\n        if current_count > best_count:\n            best_count = current_count\n            best_word = current_word\n        elif current_count == best_count:\n            # If unique counts are equal, choose the one that comes\n            # first in lexicographical order.\n            if current_word < best_word:\n                best_word = current_word\n    \n    return best_word"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    has_letters = False\n    for char in s:\n        if ('a' <= char <= 'z') or ('A' <= char <= 'Z'):\n            has_letters = True\n            break\n            \n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if 'a' <= char <= 'z':\n                transformed_chars.append(chr(ord(char) - 32))  # Convert to uppercase\n            elif 'A' <= char <= 'Z':\n                transformed_chars.append(chr(ord(char) + 32))  # Convert to lowercase\n            else:\n                transformed_chars.append(char)  # Keep other characters as they are\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if text == \"\":\n        return None\n    \n    # Encode the string to bytes using UTF-8 before hashing\n    encoded_text = text.encode('utf-8')\n    \n    # Create an MD5 hash object\n    m = hashlib.md5()\n    \n    # Update the hash object with the encoded text\n    m.update(encoded_text)\n    \n    # Return the hexadecimal digest of the hash\n    return m.hexdigest()"}
{"task_id": "HumanEval/160", "solution": "from dataclasses import dataclass\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    pass\n\nclass EvaluationError(Exception):\n    \"\"\"Raised when an arithmetic evaluation error occurs.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass OperatorMetadata:\n    name: str\n    precedence: int\n    associativity: str\n\n@dataclass\nclass OperandToken:\n    value: int\n\n@dataclass\nclass OperatorToken:\n    symbol: str\n\nOPERATOR_METADATA = {\n    \"+\": OperatorMetadata(\"+\", precedence=1, associativity=\"left\"),\n    \"-\": OperatorMetadata(\"-\", precedence=1, associativity=\"left\"),\n    \"*\": OperatorMetadata(\"*\", precedence=2, associativity=\"left\"),\n    \"//\": OperatorMetadata(\"//\", precedence=2, associativity=\"left\"),\n    \"**\": OperatorMetadata(\"**\", precedence=3, associativity=\"right\"),\n}\n\ndef safe_floor_div(a: int, b: int) -> int:\n    \"\"\"Performs floor division with a check for division by zero.\"\"\"\n    if b == 0:\n        raise EvaluationError(\"division by zero\")\n    return a // b\n\nclass Parser:\n    \"\"\"Handles input validation and tokenization.\"\"\"\n    def validate_inputs(self, operator: list[str], operand: list[int]) -> None:\n        if len(operator) != len(operand) - 1:\n            raise InvalidInputError(\"The length of operator list must be equal to the length of operand list minus one.\")\n        for op_sym in operator:\n            if op_sym not in OPERATOR_METADATA:\n                raise InvalidInputError(f\"Unsupported operator: {op_sym}\")\n        for val in operand:\n            if val < 0:\n                raise InvalidInputError(\"Operands must be non-negative integers.\")\n\n    def build_tokens(self, operator: list[str], operand: list[int]) -> list:\n        \"\"\"Constructs an infix token list from operators and operands.\"\"\"\n        tokens = []\n        for i, val in enumerate(operand):\n            tokens.append(OperandToken(val))\n            if i < len(operator):\n                tokens.append(OperatorToken(operator[i]))\n        return tokens\n\nclass Evaluator:\n    \"\"\"Converts infix tokens to RPN and evaluates the RPN expression.\"\"\"\n    def infix_to_rpn(self, tokens: list) -> list:\n        output = []\n        op_stack = []\n        for t in tokens:\n            if isinstance(t, OperandToken):\n                output.append(t)\n            elif isinstance(t, OperatorToken):\n                meta = OPERATOR_METADATA[t.symbol]\n                while op_stack:\n                    top = op_stack[-1]\n                    top_meta = OPERATOR_METADATA[top.symbol]\n                    cond_left = (meta.associativity == \"left\" and meta.precedence <= top_meta.precedence)\n                    cond_right = (meta.associativity == \"right\" and meta.precedence < top_meta.precedence)\n                    if cond_left or cond_right:\n                        output.append(op_stack.pop())\n                    else:\n                        break\n                op_stack.append(t)\n            else:\n                raise EvaluationError(\"Unknown token type encountered during RPN conversion.\")\n        while op_stack:\n            output.append(op_stack.pop())\n        return output\n\n    def evaluate_rpn(self, rpn_tokens: list) -> int:\n        \"\"\"Evaluates a list of RPN tokens.\"\"\"\n        stack = []\n        for t in rpn_tokens:\n            if isinstance(t, OperandToken):\n                stack.append(t.value)\n            elif isinstance(t, OperatorToken):\n                if len(stack) < 2:\n                    raise EvaluationError(\"Insufficient operands for operator \" + t.symbol)\n                b = stack.pop()\n                a = stack.pop()\n                if t.symbol == \"+\":\n                    stack.append(a + b)\n                elif t.symbol == \"-\":\n                    stack.append(a - b)\n                elif t.symbol == \"*\":\n                    stack.append(a * b)\n                elif t.symbol == \"//\":\n                    stack.append(safe_floor_div(a, b))\n                elif t.symbol == \"**\":\n                    stack.append(a ** b)\n                else:\n                    raise EvaluationError(f\"Unsupported operator {t.symbol} during RPN evaluation.\")\n        if len(stack) != 1:\n            raise EvaluationError(\"Invalid expression: final stack did not contain single result.\")\n        return stack[0]\n\n    def evaluate(self, operator: list[str], operand: list[int]) -> int:\n        \"\"\"Builds tokens and performs RPN conversion and evaluation.\"\"\"\n        parser_instance = Parser()\n        tokens = parser_instance.build_tokens(operator, operand)\n        rpn_tokens = self.infix_to_rpn(tokens)\n        return self.evaluate_rpn(rpn_tokens)\n\nclass Controller:\n    \"\"\"Orchestrates parsing and evaluation.\"\"\"\n    def __init__(self, parser: Parser, evaluator: Evaluator) -> None:\n        self.parser = parser\n        self.evaluator = evaluator\n\n    def compute(self, operator: list[str], operand: list[int]) -> int:\n        \"\"\"Validates inputs and computes the expression result.\"\"\"\n        self.parser.validate_inputs(operator, operand)\n        return self.evaluator.evaluate(operator, operand)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    return Controller(Parser(), Evaluator()).compute(operator, operand)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    # Helper constant representing valid even single-digits.\n    EVEN_DIGITS = frozenset({0, 2, 4, 6, 8})\n\n    # Helper exception class for invalid input ranges.\n    class InvalidRangeError(Exception):\n        def __init__(self, message: str, code: str = \"INVALID_RANGE\") -> None:\n            super().__init__(message)\n            self.message = message\n            self.code = code\n\n    # Helper validator class to ensure inputs are integers.\n    class RangeValidator:\n        @staticmethod\n        def validate(val_a, val_b) -> None:\n            \"\"\"Validates if inputs can be converted to integers, raising an error if not.\"\"\"\n            try:\n                int(val_a)\n                int(val_b)\n            except Exception:\n                raise InvalidRangeError(f\"Inputs must be integers: a={val_a}, b={val_b}\")\n\n    # Helper function to find even digits within a numeric range.\n    def intersect_even_digits_local(min_v: int, max_v: int) -> list[int]:\n        \"\"\"Returns sorted even digits (from EVEN_DIGITS) that fall within [min_v, max_v].\"\"\"\n        out = [d for d in sorted(EVEN_DIGITS) if min_v <= d <= max_v]\n        return out\n\n    # Helper in-memory cache repository for query results.\n    class InMemoryQueryRepository:\n        def __init__(self, capacity: int = 100):\n            self._capacity = capacity\n            self._store = {}\n\n        def get(self, key: tuple[int, int]) -> list[int] | None:\n            return self._store.get(key)\n\n        def set(self, key: tuple[int, int], value: list[int]) -> None:\n            if len(self._store) >= self._capacity:\n                # Evict the oldest item if capacity is reached.\n                self._store.pop(next(iter(self._store)))\n            self._store[key] = list(value)\n\n        def clear(self) -> None:\n            self._store.clear()\n\n    # Helper service class encapsulating the business logic and cache interaction.\n    class EvenDigitService:\n        def __init__(self, repo: InMemoryQueryRepository | None = None) -> None:\n            self._repo = repo\n\n        def generate(self, service_a: int, service_b: int) -> list[int]:\n            \"\"\"Computes and returns even digits between service_a and service_b, using cache if available.\"\"\"\n            min_v, max_v = (service_a, service_b) if service_a <= service_b else (service_b, service_a)\n            key: tuple[int, int] = (min_v, max_v)\n\n            if self._repo:\n                cached = self._repo.get(key)\n                if cached is not None:\n                    return list(cached)\n\n            result = intersect_even_digits_local(min_v, max_v)\n\n            if self._repo:\n                try:\n                    self._repo.set(key, result)\n                except Exception:\n                    # Log repository failures, but do not prevent computation.\n                    pass\n\n            return result\n\n    # Main execution logic for the generate_integers function.\n    validator = RangeValidator()\n    # Instantiate repository and service for each call due to 'inline' constraint.\n    repository = InMemoryQueryRepository()\n    service = EvenDigitService(repository)\n\n    validator.validate(a, b)\n\n    # Convert validated inputs to integers.\n    a_int = int(a)\n    b_int = int(b)\n\n    values = service.generate(a_int, b_int)\n    return values"}
