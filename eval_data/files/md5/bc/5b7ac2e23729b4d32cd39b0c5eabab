{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    decimal_part, _ = math.modf(number)\n    return decimal_part"}
{"task_id": "HumanEval/6", "solution": "```python\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    def _parse_single_group(group: str) -> int:\n        \"\"\"Parses a single parenthesis group and returns its maximum nesting depth.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string:\n        return []\n\n    # Normalize whitespace: trim leading/trailing, collapse multiple spaces\n    normalized_string = \" \".join(paren_string.strip().split())\n\n    if not normalized_string:\n        return []\n\n    groups = normalized_string.split(' ')\n    results = []\n    for group in groups:\n        if group: # Ensure not processing empty strings resulting from multiple spaces\n            results.append(_parse_single_group(group))\n    return results\n```"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'. \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n    if n == 1:\n        return [numbers[0]]\n    \n    result: List[int] = []\n    for i, val in enumerate(numbers):\n        result.append(val)\n        if i < n - 1:  # Only append delimeter if it's not the last element\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero\n    given a list of deposit and withdrawal operations.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    import math\n\n    class InvalidInputError(ValueError):\n        \"\"\"Raised when input numbers are invalid for MAD calculation.\"\"\"\n        pass\n\n    if numbers is None:\n        raise InvalidInputError(\"Input list cannot be None.\")\n\n    processed_numbers: List[float] = []\n    for i, num in enumerate(numbers):\n        try:\n            f_num = float(num)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Element at index {i} is not numeric: {num!r}\")\n        if math.isnan(f_num) or math.isinf(f_num):\n            raise InvalidInputError(f\"Element at index {i} is not a finite number: {num!r}\")\n        processed_numbers.append(f_num)\n\n    if not processed_numbers:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    data_sum = sum(processed_numbers)\n    data_count = len(processed_numbers)\n    mean = data_sum / data_count\n\n    deviations = [abs(x - mean) for x in processed_numbers]\n\n    mad = sum(deviations) / data_count\n\n    return mad"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through sorted numbers and check the difference between adjacent elements.\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] - sorted_numbers[i-1] < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input is a string of multiple nested parenthesis groups; separate them into a list of balanced strings, ignoring spaces.\n    Each returned group is balanced and not nested within other top-level groups.\n    \"\"\"\n    normalized_chars = [char for char in paren_string if char == '(' or char == ')']\n\n    groups = []\n    balance = 0\n    current_group_chars = []\n\n    for char in normalized_chars:\n        current_group_chars.append(char)\n        if char == '(':\n            balance += 1\n        else:  # char must be ')' based on problem context\n            balance -= 1\n\n        if balance < 0:\n            # An unmatched ')' means the current sequence is invalid.\n            # Discard the current sequence and reset for new potential groups.\n            current_group_chars = []\n            balance = 0\n        elif balance == 0:\n            # A complete and balanced top-level group is found.\n            groups.append(\"\".join(current_group_chars))\n            current_group_chars = []\n\n    return groups"}
{"task_id": "HumanEval/7", "solution": "from typing import List, Optional\nfrom .in_memory_repository import InMemoryRepository\nfrom .filter_service import FilterService\nfrom .filter_criteria import FilterCriteria\nfrom .dto_filter_request import FilterRequestDTO\nfrom .dto_filter_response import FilterResponseDTO\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    # Instantiate the default in-memory repository.\n    # The FilterService requires a repository instance, even if the strings\n    # are provided directly in the FilterRequestDTO.\n    repository = InMemoryRepository()\n\n    # Instantiate the FilterService with the repository.\n    service = FilterService(repository)\n\n    # Define the filtering criteria. Matching is case-sensitive by default.\n    criteria = FilterCriteria(substring=substring, case_sensitive=True)\n\n    # Create a request DTO, passing the input strings and criteria.\n    request = FilterRequestDTO(strings=strings, criteria=criteria)\n\n    # Call the FilterService to perform the filtering.\n    response = service.filter(request)\n\n    # Return the list of filtered results from the response.\n    return response.results"}
{"task_id": "HumanEval/8", "solution": "```python\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    # Assumes inputs 'a' and 'b' are of equal length and contain only '0' or '1'.\n    for i in range(len(a)):\n        # Perform character-wise XOR.\n        if a[i] != b[i]:\n            result_chars.append('1')\n        else:\n            result_chars.append('0')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_string = strings[0]\n    longest_length = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > longest_length:\n            longest_string = s\n            longest_length = len(s)\n\n    return longest_string"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    The result is always non-negative, and gcd(0, 0) is defined as 0.\n    \"\"\"\n    a_abs, b_abs = abs(a), abs(b)\n\n    if a_abs == 0 and b_abs == 0:\n        return 0\n\n    while b_abs:\n        a_abs, b_abs = b_abs, a_abs % b_abs\n    return a_abs"}
